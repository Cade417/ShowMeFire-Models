# Copy to .env and adjust for the local training machine. Never commit tokens.
SMF_DATA_ROOT=D:\_Development\ShowMeFire\training-data

# Optional: Model Lab CDN/R2 archive sync (public CDN works without these).
# CDN_BASE_URL=https://cdn.showmefire.org
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ACCOUNT_ID=
# R2_BUCKET=cdn-showmefire

# Required for scripts/migration/ (full R2 + server -> local HDD pull):
# same three R2_* values as above (copy from api/.env), plus:
# SMF_SSH_TARGET=user@server
# SMF_REMOTE_ARCHIVE_DIR=/remote/path/to/api/data_archive_day/

# Optional: path to a local sibling checkout of the api/ repo, so the
# dashboard (dashboard/app.py) can also trigger the detection-confidence
# model's retrain.py. Leave unset if you don't have that repo checked out
# locally - the dashboard just shows it as "not configured".
# SMF_API_REPO_ROOT=M:\_Development\ShowMeFire\api
